<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Night theme -->
    <style name="Base.Theme.InventoryTracking" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_dark</item>
        <item name="colorOnPrimary">@color/mint_light</item>

        <item name="colorSecondary">@color/teal_light</item>
        <item name="colorOnSecondary">@color/forest_green_dark</item>

        <item name="colorTertiary">@color/teal_light</item>
        <item name="colorOnTertiary">@color/forest_green_dark</item>

        <item name="colorSurface">@color/teal_dark</item>
        <item name="colorOnSurface">@color/mint_light</item>

        <item name="android:colorBackground">@color/forest_green_dark</item>
        <item name="colorOnBackground">@color/mint_light</item>

        <item name="toolbarStyle">@style/CustomToolbarStyle</item>

    </style>

    <style name="DialogBackground">
        <item name="android:background">@color/grey_dark</item>
    </style>

    <style name="CustomToolbarStyle" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/teal_dark</item>
        <item name="titleTextColor">@color/mint_light</item>
        <item name="navigationIconTint">?attr/colorOnPrimary</item>
        <item name="android:theme">@style/CustomSearchViewStyle</item>
    </style>

    <style name="CustomSearchViewStyle" parent="ThemeOverlay.Material3.Dark">
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
    </style>

    <style name="CardLabel" >
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Theme.InventoryTracking" parent="Base.Theme.InventoryTracking" />

</resources>