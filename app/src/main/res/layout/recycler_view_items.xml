<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:clickable="true"
    android:focusable="true"
    card_view:cardCornerRadius="5dp"
    card_view:cardUseCompatPadding="true"
    android:layout_margin="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:background="@drawable/item_background_selector"
        >



        <ImageView
            android:id="@+id/item_image_view"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/item_image"
            app:layout_constraintTop_toBottomOf="@id/item_text_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="30dp"
            tools:src="@drawable/vector_logo" />


        <TextView
            android:id="@+id/item_text_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            style="@style/CardLabel"
            android:gravity="center_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/item_image_view"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="3dp"
            tools:text="Superultramicroscopicsilicovolcaniconiosis"/>

        <TextView
            android:id="@+id/item_quantity_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qty"
            style="@style/CardLabel"
            app:layout_constraintHorizontal_chainStyle="packed"
            android:gravity="end"
            app:layout_constraintEnd_toStartOf="@id/item_quantity"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="6dp"
            />

        <TextView
            android:id="@+id/item_quantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/CardLabel"
            android:ellipsize="end"
            android:maxLines="1"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/item_quantity_label"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="999999999999999999999999999999999999999999999"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>