<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:clickable="true"
    android:focusable="true"
    card_view:cardCornerRadius="5dp"
    card_view:cardUseCompatPadding="true"
    android:layout_margin="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:background="@drawable/item_background_selector"
        >

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.3"
            card_view:layout_constraintGuide_begin="132dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.6" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.83" />



        <TextView
            android:id="@+id/item_text_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxEms="7"
            style="@style/CardLabel"
            android:gravity="center_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Playstation 5 Pro U"/>




        <TextView
            android:id="@+id/item_category_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/CardLabel"
            android:maxEms="6"
            android:maxLines="1"
            android:gravity="end"
            android:ellipsize="end"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/guide_3"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Entertainment Systems"
            />

        <TextView
            android:id="@+id/item_quantity_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qty"
            style="@style/CardLabel"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/guide_6"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/item_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/CardLabel"
            android:ellipsize="end"
            android:maxEms="3"
            android:maxLines="1"
            android:gravity="end"
            android:layout_marginEnd="10dp"
            app:layout_constraintStart_toEndOf="@id/item_quantity_label"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="99999999999"
            />

        <TextView
            android:id="@+id/item_price_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/CardLabel"
            android:maxEms="4"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/guide_8"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="$1999.00"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>