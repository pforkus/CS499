<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sort_by"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/sortFieldGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/sort_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/name"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/sort_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_field" />

        <RadioButton
            android:id="@+id/sort_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/date_added" />

        <RadioButton
            android:id="@+id/sort_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/price_field" />

    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        android:layout_marginVertical="12dp" />

    <RadioGroup
        android:id="@+id/sortDirectionGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/sort_asc"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/ascending"
            android:checked="true" />

        <RadioButton
            android:id="@+id/sort_desc"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/descending" />

    </RadioGroup>

    <Button
        android:id="@+id/applySortButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/apply" />

</LinearLayout>